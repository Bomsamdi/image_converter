<fieldset class="my-3">
    <legend class="fs-6 text-uppercase text-secondary">Output format</legend>
    <div class="btn-group w-100" role="group">
        <input type="radio" class="btn-check" name="format" value="webp" id="f-webp" checked>
        <label class="btn btn-outline-secondary" for="f-webp">
            WebP <span class="small text-secondary d-block">works everywhere</span>
        </label>
        <input type="radio" class="btn-check" name="format" value="avif" id="f-avif">
        <label class="btn btn-outline-secondary" for="f-avif">
            AVIF <span class="small text-secondary d-block">smaller, slower to encode</span>
        </label>
    </div>
</fieldset>
