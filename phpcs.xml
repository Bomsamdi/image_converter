<?xml version="1.0"?>
<ruleset name="image_converter">
    <description>PSR-12, with short array syntax required.</description>

    <!-- display progress -->
    <arg value="p"/>
    <!-- use colors in output -->
    <arg name="colors"/>

    <!-- inherit rules from: -->
    <rule ref="PSR12"/>
    <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>

    <!-- Paths to check -->
    <file>src</file>
    <file>tests</file>
    <file>app</file>
    <file>public</file>
</ruleset>