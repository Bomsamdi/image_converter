{
    "name": "bomsamdi/image-converter",
    "description": "A small HTTP service that converts PNG and JPEG images to WebP or AVIF, one file or a whole ZIP.",
    "keywords": ["webp", "avif", "image", "converter", "slim", "gd"],
    "homepage": "https://github.com/Bomsamdi/image_converter",
    "license": "MIT",
    "type": "project",
    "authors": [
        {
            "name": "Bartosz Wróbel",
            "homepage": "https://github.com/Bomsamdi"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "monolog/monolog": "^3.7",
        "php-di/php-di": "^7.0",
        "slim/php-view": "^3.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public",
        "test": "phpunit",
        "lint": "phpcs",
        "analyse": "phpstan",
        "check": ["@lint", "@analyse", "@test"]
    }
}
